---
import Header from "./header.astro";
import "@fontsource-variable/figtree/wght.css";

// Set the layout properties
export interface Props {
    description?: string;
    navigation?: boolean;
    title?: string;
}

const { description, navigation, title } = Astro.props;

// Set the canonical URL
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="en-GB">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {typeof title !== "undefined" ? <title>{title} - Orry on the Web</title> : <title>Orry on the Web</title>}
        {typeof description !== "undefined" && <meta name="description" content={description}>}
        <meta name="theme-color" content="#7614e6">
        <meta name="google-site-verification" content="nLUL7swGgc-k1Io-r5lZYk_i8aXedERKq6Mb6PEYUbY">
        <meta name="msvalidate.01" content="8BD1560DF5967630C8CEE1C55F8A75A9">
        <link href={canonicalURL} rel="canonical">
        <link href="/favicon.ico" rel="icon" type="image/x-icon">
        {import.meta.env.PROD && <script src="https://static.cloudflareinsights.com/beacon.min.js" defer data-cf-beacon='{"token": "2be49cce999f4eeca191d570eb429b5c"}'></script>}
		<meta name="generator" content={Astro.generator} />
    </head>
    <body>
        <Header navigation={navigation} />
        <slot />
    </body>
</html>

<script>
    import "@hotwired/turbo";
    import { Application } from "@hotwired/stimulus";
    import figlet from "figlet";
    // @ts-ignore
    import standard from "figlet/importable-fonts/Standard.js";
    import HeaderController from "../controllers/header_controller.ts";
    import Error404Controller from "../controllers/error404_controller.ts";

    figlet.parseFont("Standard", standard);

    figlet.text("Hello!", { font: "Standard" }, function(err, data) {
        if (err) {
            console.error(err);
            return;
        }

        let figletText:string = `%c${data}`;
        let messageText:string = "\nI see you there, poking around the code ;)";
        messageText += "\nWant to see the source code for this site? Head over to https://github.com/orryverducci/orry-on-the-web";

        console.info(figletText, "color: #52c41a", messageText);
    });

    const application:Application = Application.start();

    application.register("header", HeaderController);
    application.register("error404", Error404Controller);
</script>

<style lang="scss" is:global>
    @use "../styles/reset";
    @use "../styles/fonts";
    @use "../styles/base";
    @use "../styles/header";
</style>
