---
import Header from "./header.astro";
import { Font } from "astro:assets";
import figlet from "figlet";
// @ts-ignore
import standard from "figlet/importable-fonts/Standard.js";

// Set the layout properties
export interface Props {
    description?: string;
    navigation?: boolean;
    title?: string;
}

const { description, navigation, title } = Astro.props;

// Set the canonical URL
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Generate figlet for the user console
figlet.parseFont("Standard", standard);
const figletText:string = await figlet.text("Hello!", { font: "Standard" });
---

<!DOCTYPE html>
<html lang="en-GB">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {typeof title !== "undefined" ? <title>{title} - Orry on the Web</title> : <title>Orry on the Web</title>}
        {typeof description !== "undefined" && <meta name="description" content={description}>}
        <meta name="theme-color" content="#7614e6">
        <meta name="color-scheme" content="light dark" />
        <link href={canonicalURL} rel="canonical">
        <link href="/favicon.ico" rel="icon" type="image/x-icon">
        {import.meta.env.PROD && <script src="https://static.cloudflareinsights.com/beacon.min.js" defer data-cf-beacon='{"token": "2be49cce999f4eeca191d570eb429b5c"}'></script>}
		<meta name="generator" content={Astro.generator} />
        <Font cssVariable="--font-figtree" preload />
        <Font cssVariable="--font-vcrosd" />
        <Font cssVariable="--font-modeseven" />
    </head>
    <body data-figlet={figletText}>
        <Header navigation={navigation} />
        <slot />
    </body>
</html>

<script>
    import "@hotwired/turbo";
    import { Application } from "@hotwired/stimulus";
    import "@lottiefiles/dotlottie-wc";
    import HeaderController from "../controllers/header_controller.ts";
    import Error404Controller from "../controllers/error404_controller.ts";

    if (document.querySelector("body")?.dataset.figlet) {
        let messageText:string = "\nI see you there, poking around the code ;)";
        messageText += "\nWant to see the source code for this site? Head over to https://github.com/orryverducci/orry-on-the-web";
        console.info("%c" + document.querySelector("body").dataset.figlet, "color: #8E0EF0", messageText);
    }

    const application:Application = Application.start();

    application.register("header", HeaderController);
    application.register("error404", Error404Controller);
</script>

<style lang="scss" is:global>
    @use "../styles/reset";
    @use "../styles/breakpoints" as *;
    @use "../styles/colours" as *;

    html {
        background: colour(purple, 900);
        font-size: 16px;

        @include media-breakpoint-up(medium) {
            font-size: 18px;
        }

        @include media-breakpoint-up(xl) {
            font-size: 20px;
        }
    }

    body {
        background: #fff;
        color: colour(grey, 700);
        font-family: var(--font-figtree);
        letter-spacing: 0.005rem;

        @media (prefers-color-scheme: dark) {
            background: colour(grey, 900);
            color: colour(grey, 200);
        }
    }

    strong, h1, h2, h3, h4, h5, h6 {
        color: colour(grey, 900);
        font-weight: 600;

        @media (prefers-color-scheme: dark) {
            color: colour(grey, 100);
        }
    }

    main {
        min-height: 100svh;
        padding-top: 3rem;
        position: relative;
        z-index: 1;

        @include media-breakpoint-up(xl) {
            padding-top: 2.5rem;
        }
    }

    a {
        color: colour(purple, 500);
        text-decoration: underline 0.05em colour(purple, 500, 0);
        text-underline-offset: 0.15em;
        transition: text-decoration-color 300ms;

        @media (prefers-color-scheme: dark) {
            color: colour(purple, 200);
            text-decoration-color: colour(purple, 200, 0);
        }

        &:hover {
            text-decoration-color: colour(purple, 500);

            @media (prefers-color-scheme: dark) {
                text-decoration-color: colour(purple, 200);
            }
        }
    }
</style>
