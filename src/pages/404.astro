---
import Layout from "../layouts/layout.astro";
---

<Layout title="Page Not Found">
    <main data-controller="error404">
        <canvas id="noise" aria-hidden="true" data-error404-target="background"></canvas>
        <div id="channel-block">
            <p>404</p>
            <h1>Page Not Found</h1>
        </div>
        <div id="error-info">
            <p class="top-line">The page you are looking for could not be found :(</p>
            <p>It may have moved, or there may be a typo in the address. Try using the menu to find the page you are looking for.</p>
        </div>
    </main>
</Layout>

<style lang="scss">
    @use "../styles/breakpoints" as *;

    main {
        background: #777;
        display: flex;
		flex-direction: column;
        gap: 1rem;
        justify-content: space-evenly;
		padding: 3rem 2rem 1rem 2rem;
        text-align: center;

        @include media-breakpoint-up(xl) {
            padding: 3.5rem 4rem 3rem 4rem;
            justify-content: space-between;
        }

        &::after {
            animation: scanlines 0.1s infinite linear;
            background: linear-gradient(rgba(255,255,255,0) 50%, rgba(0,0,0,0.06) 50%);
            background-size: 100% 4px;
            bottom: -4px;
            content: "";
            display: block;
            left: 0;
            pointer-events: none;
            position: absolute;
            right: 0;
            top: -4px;
            z-index: 3;

            @media (prefers-reduced-motion: reduce) {
                display: none;
            }
        }
	}

    @keyframes scanlines {
        0%   { transform: translateY(0); }
        100% { transform: translateY(5px); }
    }

    #noise {
        height: 100%;
        left: 0;
        position: absolute;
        top: 0;
        width: 100%;
        z-index: 0;

        @media (prefers-reduced-motion: reduce) {
            display: none;
        }
    }

    #channel-block {
        color: #FFF;
        font-family: var(--font-vcrosd);
        paint-order: stroke fill;
        text-shadow: -0.2em -0.2em 0 #000, 0 -0.2em 0 #000, 0.2em -0.2em 0 #000, -0.2em 0 0 #000, 0.2em 0 0 #000, -0.2em 0.2em 0 #000, 0 0.2em 0 #000, 0.2em 0.2em 0 #000;
        text-transform: uppercase;
        z-index: 1;
        -moz-osx-font-smoothing: grayscale;
        -webkit-font-smoothing: antialiased;

        @include media-breakpoint-up(xl) {
            text-align: right;
        }

        p {
            font-size: 4rem;
            line-height: 1em;
        }

        h1 {
            color: inherit;
        }
    }

    #error-info {
        background: #00f;
        color: #fff;
        font-family: var(--font-modeseven);
        padding: 1rem 2rem;
        z-index: 2;
        -moz-osx-font-smoothing: grayscale;
        -webkit-font-smoothing: antialiased;

        @include media-breakpoint-up(xl) {
            text-align: left;
            width: 70%;
        }

        .top-line {
            color: #ff0;
        }
    }
</style>
