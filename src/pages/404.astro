---
import Layout from "../layouts/layout.astro";
---

<Layout title="Page Not Found">
    <main data-controller="error404">
        <canvas id="noise" aria-hidden="true" data-error404-target="background"></canvas>
        <div id="channel-block">
            <p>404</p>
            <h1>Page Not Found</h1>
        </div>
        <div id="error-info">
            <p class="top-line">The page you are looking for could not be found :(</p>
            <p>It may have moved, or there may be a typo in the address. Try using the menu to find the page you are looking for.</p>
        </div>
    </main>
</Layout>

<style lang="scss">
    main {
		padding: 0;
        position: relative;
	}

    #noise {
        height: 100%;
        position: absolute;
        width: 100%;
        z-index: 0;

        &::after {
            background: repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.3) 0px, transparent 1px, transparent 2px, rgba(0, 0,0, 0.3) 3px);
            content: '';
            display: block;
            height: 100%;
            left: 0;
            pointer-events: none;
            position: absolute;
            top: 0;
            width: 100%;
            z-index: 3;
        }
    }

    #channel-block {
        animation: syncloss 5s infinite;
        color: #FFF;
        font-family: "VCR OSD Mono", "Montserrat", Arial, Helvetica, sans-serif;
        paint-order: stroke fill;
        position: absolute;
        right: 5%;
        text-align: right;
        text-shadow: -0.2em -0.2em 0 #000, 0 -0.2em 0 #000, 0.2em -0.2em 0 #000, -0.2em 0 0 #000, 0.2em 0 0 #000, -0.2em 0.2em 0 #000, 0 0.2em 0 #000, 0.2em 0.2em 0 #000;
        text-transform: uppercase;
        top: calc(5% + 4rem);
        z-index: 1;
        -moz-osx-font-smoothing: grayscale;
        -webkit-font-smoothing: antialiased;

        p {
            font-size: 4rem;
            line-height: 1em;
        }

        h1 {
            color: inherit;
        }
    }

    #error-info {
        animation: syncloss 5s infinite;
        background: #00f;
        bottom: 10%;
        color: #fff;
        font-family: "ModeSeven", "Montserrat", Arial, Helvetica, sans-serif;
        left: 5%;
        max-width: 50%;
        padding: 1rem 2rem;
        position: absolute;
        z-index: 2;
        -moz-osx-font-smoothing: grayscale;
        -webkit-font-smoothing: antialiased;

        .top-line {
            color: #ff0;
        }

        p:last-child {
            margin-bottom: 0;
        }
    }
</style>
