---
import Layout from "../layouts/layout.astro";
---

<Layout description="The online home of Orry Verducci." navigation={false}>
	<main>
		<div id="bio">
			<img src="/images/profile-pic.jpg" alt="Headshot of Orry Verducci" class="profile-pic" decoding="async" />
			<div class="heading">
				<h1>Hey, I'm Orry</h1>
				<dotlottie-wc src="/animations/wave.json" autoplay loop speed="0.7"></dotlottie-wc>
			</div>
			<p>Welcome to my corner of the web!</p>
			<p>I'm a Broadcast Engineer working in radio and television, based in <a href="https://en.wikipedia.org/wiki/Cambridgeshire" target="_blank" rel="noopener noreferrer">Cambridgeshire</a> and <a href="https://en.wikipedia.org/wiki/London" target="_blank" rel="noopener noreferrer">London</a> UK.</p>
		</div>
	</main>
</Layout>

<style lang="scss">
	@use "../styles/breakpoints" as *;
	@use "../styles/colours" as *;
	@use "../styles/shadow" as *;

    main {
		display: flex;
		flex-direction: column;
		padding: 0;
		text-align: center;

		@include media-breakpoint-up(large) {
			text-align: left;
			flex-direction: row;
		}

		@include media-breakpoint-up(large) {
			font-size: 1.2rem;
		}

		@include media-breakpoint-up(xl) {
			font-size: 1.4rem;
		}
	}

	#bio {
		align-items: center;
		background: linear-gradient(135deg in oklch, colour(purple, 800), colour(purple, 100));
		color: #fff;
		display: flex;
		flex-direction: column;
		gap: 1.4rem;
		padding: 6rem 2rem 4rem 2rem;

		a {
			color: inherit;
			text-decoration: underline 0.05em rgba(255, 255, 255, 0);

			&:hover {
				text-decoration-color: rgba(255, 255, 255, 1);
			}
		}

		@include media-breakpoint-up(large) {
			align-items: flex-start;
			flex: 0 0 50dvw;
			justify-content: center;
			padding: 3rem 2rem 1rem 10dvw;
		}

		@media (prefers-color-scheme: dark) {
			background: linear-gradient(135deg in oklch, dark-colour(purple, 800), dark-colour(purple, 100));
            color: colour(grey, 200);
        }
	}

	.profile-pic {
		border: 0.3rem solid #fff;
		border-radius: 50%;
		height: 15rem;
		width: 15rem;

		@include shadow(medium, colour(purple, 500));

		@include media-breakpoint-up(large) {
			height: 14rem;
			width: 14rem;
		}

		@media (prefers-color-scheme: dark) {
            border-color: colour(grey, 200);

			@include shadow(medium, dark-colour(purple, 500));
        }
	}

	.heading {
		align-items: center;
		display: flex;
		justify-content: center;
		gap: 0.5rem;
	}

	h1 {
		color: inherit;
		font-size: 2em;
	}

	dotlottie-wc {
		display: inline-block;
		height: 2em;
		width: 2em;
	}
</style>
