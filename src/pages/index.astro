---
import Layout from "../layouts/layout.astro";
import { Icon } from "@dallay/astro-icon/components";
---

<Layout description="The online home of Orry Verducci." navigation={false}>
	<main>
		<div id="bio">
			<img src="/images/profile-pic.jpg" alt="Headshot of Orry Verducci" class="profile-pic" decoding="async" />
			<div class="text-block">
				<div class="heading">
					<h1>Hey, I'm Orry</h1>
					<dotlottie-wc src="/animations/wave.json" autoplay loop speed="0.7"></dotlottie-wc>
				</div>
				<p>Welcome to my corner of the web!</p>
				<p>I'm a Broadcast Engineer working in radio and television, based in <a href="https://en.wikipedia.org/wiki/Cambridgeshire" target="_blank" rel="noopener noreferrer">Cambridgeshire</a> and <a href="https://en.wikipedia.org/wiki/London" target="_blank" rel="noopener noreferrer">London</a> UK.</p>
			</div>
		</div>
		<div id="content">
			<ul id="navigation">
				<li>
					<a class="about" href="#">
						<Icon name="andrsrxn:face-smile" role="img" aria-label="Instagram" />
						<div>
							<strong>About Me</strong>
							Find out more about me and what I do.
						</div>
						<div class="coming-soon">Coming Soon</div>
					</a>
				</li>
				<li>
					<a class="apps" href="#">
						<Icon name="andrsrxn:browser-cursor-click" role="img" aria-label="Instagram" />
						<div>
							<strong>Apps</strong>
							Discover the apps I've made.
						</div>
						<div class="coming-soon">Coming Soon</div>
					</a>
				</li>
				<li>
					<a class="photos" href="#">
						<Icon name="andrsrxn:image" role="img" aria-label="Instagram" />
						<div>
							<strong>Photos</strong>
							Come see the world through my lens.
						</div>
						<div class="coming-soon">Coming Soon</div>
					</a>
				</li>
				<li>
					<a class="contact" href="#">
						<Icon name="andrsrxn:mail" role="img" aria-label="Instagram" />
						<div>
							<strong>Contact Me</strong>
							Get in touch with me.
						</div>
						<div class="coming-soon">Coming Soon</div>
					</a>
				</li>
			</ul>
			<div id="social-links">
				<p>Find me on:</p>
				<ul>
					<li><a href="https://www.instagram.com/orry.verducci/" title="Instagram" target="_blank" rel="noopener noreferrer"><Icon name="bxl:instagram" role="img" aria-label="Instagram" /></a></li>
                    <li><a href="https://www.threads.com/@orry.verducci" title="Threads" target="_blank" rel="noopener noreferrer"><Icon name="bxl:threads" role="img" aria-label="Threads" /></a></li>
                    <li><a href="https://github.com/orryverducci/" title="GitHub" target="_blank" rel="noopener noreferrer"><Icon name="bxl:github" role="img" aria-label="GitHub" /></a></li>
                    <li><a href="https://www.linkedin.com/in/orryv/" title="LinkedIn" target="_blank" rel="noopener noreferrer"><Icon name="bxl:linkedin-square" role="img" aria-label="LinkedIn" /></a></li>
					<li><a href="https://medium.com/@orryv" title="Medium" target="_blank" rel="noopener noreferrer"><Icon name="bxl:medium-square" role="img" aria-label="Medium" /></a></li>
					<li><a href="https://buymeacoffee.com/orryv" title="Buy Me a Coffee" target="_blank" rel="noopener noreferrer"><Icon name="bxl:buy-me-a-coffee" role="img" aria-label="Buy Me a Coffee" /></a></li>
				</ul>
			</div>
		</div>
	</main>
</Layout>

<style lang="scss">
	@use "../styles/breakpoints" as *;
	@use "../styles/colours" as *;
	@use "../styles/shadow" as *;
	@use "@material/animation";

    main {
		display: flex;
		flex-direction: column;
		padding: 0;
		text-align: center;

		@include media-breakpoint-up(large) {
			text-align: left;
			flex-direction: row;
			font-size: 1.2rem;
		}

		@include media-breakpoint-up(xl) {
			font-size: 1.4rem;
		}
	}

	#bio {
		align-items: center;
		background: linear-gradient(135deg in oklch, colour(purple, 800), colour(purple, 100));
		color: #fff;
		display: flex;
		flex-direction: column;
		gap: 1.4em;
		padding: 5rem 2rem 3rem 2rem;

		a {
			color: inherit;
			text-decoration: underline 0.05em rgba(255, 255, 255, 0);

			&:hover {
				text-decoration-color: rgba(255, 255, 255, 1);
			}
		}

		@include media-breakpoint-only(medium) {
			flex-direction: row;
			gap: 2em;
			padding: 5rem 3rem 3rem 3rem;
			text-align: left;
		}

		@include media-breakpoint-up(large) {
			align-items: flex-start;
			flex: 0 0 50dvw;
			justify-content: center;
			padding: 4rem 2rem 2rem 10dvw;
		}

		@media (prefers-color-scheme: dark) {
			background: linear-gradient(135deg in oklch, dark-colour(purple, 800), dark-colour(purple, 100));
            color: colour(grey, 200);
        }
	}

	.profile-pic {
		border: 0.3rem solid #fff;
		border-radius: 50%;
		height: 14rem;
		width: 14rem;

		@include shadow(medium, colour(purple, 500));

		@media (prefers-color-scheme: dark) {
            border-color: colour(grey, 200);

			@include shadow(medium, dark-colour(purple, 500));
        }
	}

	.text-block {
		display: flex;
		flex-direction: column;
		gap: 1.4em;
	}

	.heading {
		align-items: center;
		display: flex;
		justify-content: center;
		gap: 0.5rem;

		@include media-breakpoint-only(medium) {
			justify-content: flex-start;
		}

		@include media-breakpoint-up(large) {
			justify-content: flex-start;
		}
	}

	h1 {
		color: inherit;
		font-size: 2em;
	}

	dotlottie-wc {
		display: inline-block;
		height: 2em;
		width: 2em;
	}

	#content {
		display: flex;
		gap: 2rem;
		flex-direction: column;
		justify-content: center;
		padding: 3rem 2rem;

		@include media-breakpoint-up(large) {
			flex: 0 0 50dvw;
			padding: 4rem 3rem;
		}
	}

	#navigation {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		list-style-type: none;
		padding: 0;
		text-align: left;

		a {
			align-items: center;
			color: inherit;
			display: flex;
			flex-direction: row;
			gap: 1.5rem;
			text-decoration: none;
		}

		svg {
			height: 2rem;
			transition: color 0.2s linear;
			width: 2rem;
		}

		div {
			flex: 1 1 auto;

			&.coming-soon {
				color: #fff;
				background-color: colour(cherry, 600);
				border-radius: 0.3rem;
				flex: 0 0 6rem;
				line-height: 1.4rem;
				padding: 0.2rem 0.5rem;
				text-align: center;

				@media (prefers-color-scheme: dark) {
					background-color: colour(cherry, 700);
				}
			}
		}

		strong {
			display: block;
		}
	}

	.about:hover svg {
		color: colour(orange, 200);

		@media (prefers-color-scheme: dark) {
			color: colour(orange, 100);
		}
	}

	.apps:hover svg {
		color: colour(green, 200);

		@media (prefers-color-scheme: dark) {
			color: colour(green, 100);
		}
	}

	.photos:hover svg {
		color: colour(blue, 200);

		@media (prefers-color-scheme: dark) {
			color: colour(blue, 100);
		}
	}

	.contact:hover svg {
		color: colour(cherry, 200);

		@media (prefers-color-scheme: dark) {
			color: colour(cherry, 100);
		}
	}

	#social-links {
		align-items: center;
		display: flex;
		flex-direction: row;
		gap: 1rem;
		justify-content: center;

		ul {
			display: flex;
			flex-direction: row;
			gap: 1rem;
			list-style-type: none;
			padding: 0;
		}

		a {
			color: inherit;
			display: inline-block;
			font-size: 1.2rem;
			transform: scale(1);
			transition: color 0.2s linear, transform 0.2s animation.$standard-curve-timing-function;
			vertical-align: middle;

			&:hover {
				color: colour(purple, 500);
				transform: scale(1.3);

				@media (prefers-color-scheme: dark) {
					color: colour(purple, 200);
				}
			}
		}

		@include media-breakpoint-up(large) {
			justify-content: flex-start;
		}
	}
</style>
